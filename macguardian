#!/bin/bash

# Friendly command-line entry point for MacGuardian.

set -uo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    LINK_TARGET="$(readlink "$SOURCE")"
    if [[ "$LINK_TARGET" = /* ]]; then
        SOURCE="$LINK_TARGET"
    else
        SOURCE="$SOURCE_DIR/$LINK_TARGET"
    fi
done
PROJECT_ROOT="$(cd -P "$(dirname "$SOURCE")" && pwd)"
UPDATE_SCRIPT="$PROJECT_ROOT/MacGuardianSuite/package_updates.sh"

usage() {
    cat <<'EOF'
MacGuardian

Usage:
  macguardian checkup [--quick|--full]  One-button health + security checkup
  macguardian tailscale          Diagnose Tailscale problems
  macguardian browsers           Find risky Chrome/Firefox extensions
  macguardian report             Show the last checkup report
  macguardian mcp                Run the MCP server (for Claude, Codex, Cursor)
  macguardian setup-agents       Register the MCP server and skill with your AI tools
  macguardian update             Refresh catalogs and list available updates
  macguardian upgrade [OPTIONS]  Upgrade Homebrew tools/apps and App Store apps
  macguardian all [OPTIONS]      Refresh catalogs, then upgrade everything
  macguardian app                Open MacGuardian Suite
  macguardian doctor             Run MacGuardian's self-check

Upgrade options:
  -y, --yes                      Run Homebrew upgrades without confirmation
  --batch                        One download burst (one firewall prompt, faster)

Apps installed directly from vendor websites still use their own updater.
EOF
}

COMMAND="${1:-help}"
[ "$#" -gt 0 ] && shift

SUITE="$PROJECT_ROOT/MacGuardianSuite"
case "$COMMAND" in
    checkup|check|scan)
        exec /bin/bash "$SUITE/checkup.sh" "$@"
        ;;
    tailscale|ts)
        exec /bin/bash "$SUITE/tailscale_doctor.sh" "$@"
        ;;
    browsers|extensions)
        exec /usr/bin/env python3 -I "$SUITE/browser_audit.py" "$@"
        ;;
    report)
        if [ -f "$HOME/.macguardian/checkup/latest.txt" ]; then cat "$HOME/.macguardian/checkup/latest.txt"
        else echo "No checkup has run yet. Run: macguardian checkup"; fi
        ;;
    mcp)
        exec /usr/bin/env python3 "$SUITE/mcp_server.py"
        ;;
    setup-agents)
        exec /bin/bash "$SUITE/install_agent_tools.sh" "$@"
        ;;
    update)
        exec /bin/bash "$UPDATE_SCRIPT" update "$@"
        ;;
    upgrade|all)
        exec /bin/bash "$UPDATE_SCRIPT" "$COMMAND" --install-mas "$@"
        ;;
    app)
        exec /usr/bin/open "/Applications/MacGuardian Suite.app"
        ;;
    doctor)
        exec /bin/bash "$PROJECT_ROOT/MacGuardianSuite/self_check.sh" "$@"
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        echo "Unknown command: $COMMAND" >&2
        usage >&2
        exit 2
        ;;
esac
